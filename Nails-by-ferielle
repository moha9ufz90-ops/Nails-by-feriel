        .contact-section h2 { color: #f0e6d3; }

        .contact-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
            margin-top: 40px;
        }

        .contact-card {
            background: rgba(255,255,255,0.05);
            padding: 30px;
            border-radius: 20px;
            text-align: center;
            border: 1px solid rgba(201, 169, 97, 0.2);
            transition: all 0.3s;
        }

        .contact-card:hover {
            transform: translateY(-5px);
            border-color: #c9a961;
        }

        .contact-icon { font-size: 2.5em; margin-bottom: 15px; }

        .contact-card h3 {
            color: #c9a961;
            margin-bottom: 10px;
        }

        .contact-card a {
            color: #ccc;
            text-decoration: none;
            font-size: 1.1em;
