        .insta-card { border-color: rgba(220, 39, 67, 0.3); }

        footer {
            background: #1a1a1a;
            color: #777;
            text-align: center;
            padding: 30px 20px;
        }

        footer a { color: #c9a961; text-decoration: none; }

        @media (max-width: 768px) {
            .nav-links {
                display: none;
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                background: #faf6f1;
                flex-direction: column;
                padding: 20px;
                gap: 15px;
