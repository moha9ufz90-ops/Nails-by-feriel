        .section-header p { color: #888; font-size: 1.1em; }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
        }

        .service-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            transition: transform 0.3s;
            border: 1px solid #f0e6d3;
        }

        .service-card:hover { transform: translateY(-10px); }

        .service-img {
            width: 100%;
            height: 200px;
            background: linear-gradient(45deg, #e8b4b8, #d4a5a5);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3em;
        }

        .service-content { padding: 25px; }

        .service-content h3 {
            color: #8b7355;
            font-size: 1.3em;
            margin-bottom: 10px;
        }

        .service-content p {
