    <script>
        // Variables globales
        let semaineActuelle = 0;
        let jourSelectionne = null;
        let heureSelectionnee = null;
        
        const HEURES = ['11:00','12:00','13:00','14:00','15:00','16:00','17:00','18:00'];
        const JOURS_OUVERTS = [0,2,3,4,5,6];
        const JOURS_NOMS = ['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
        const JOURS_ABR = ['Dim','Lun','Mar','Mer','Jeu','Ven','Sam'];

        // Initialisation
        document.addEventListener('DOMContentLoaded', function() {
            genererCalendrier();
            
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if(entry.isIntersecting) entry.target.classList.add('visible');
                });
            }, {threshold:0.1});
            
            document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
        });

        function toggleMenu() {
            document.getElementById('navLinks').classList.toggle('active');
        }

        // Calendrier
        function genererCalendrier() {
            const grid = document.getElementById('calendrierGrid');
            grid.innerHTML = '';
            
            const labels = ['Dim','Lun','Mar','Mer','Jeu','Ven','Sam'];
            labels.forEach(label => {
                const div = document.createElement('div');
                div.className = 'cal-jour-label';
                div.textContent = label;
                grid.appendChild(div);
            });
            
            const auj = new Date();
            const debut = new Date(auj);
            debut.setDate(auj.getDate() + (semaineActuelle * 7) - auj.getDay());
            
            for(let i=0; i<<35; i++) {
                const date = new Date(debut);
                date.setDate(debut.getDate() + i);
                
                const jourSem = date.getDay();
                const dateStr = date.toISOString().split('T')[0];
                const estOuvert = JOURS_OUVERTS.includes(jourSem);
                const estPasse = date < new Date(auj.setHours(0,0,0,0));
                
                const btn = document.createElement('div');
                btn.className = 'cal-jour';
                
                if(estPasse || !estOuvert) {
                    btn.classList.add('ferme');
                } else {
                    btn.onclick = () => selectJour(btn, dateStr, JOURS_NOMS[jourSem], date.getDate());
                }
                
                btn.innerHTML = `<span class="jour-num">${date.getDate()}</span><span class="jour-nom">${JOURS_ABR[jourSem]}</span>`;
                grid.appendChild(btn);
            }
        }

        function changerSemaine(dir) {
            semaineActuelle += dir;
            if(semaineActuelle < 0) semaineActuelle = 0;
            genererCalendrier();
        }

        function selectJour(btn, dateStr, nomJour, numJour) {
            document.querySelectorAll('.cal-jour').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            jourSelectionne = { date: dateStr, nom: nomJour, num: numJour };
            
            genererHeures();
            document.getElementById('heuresContainer').style.display = 'block';
            updateWhatsApp();
        }

        function genererHeures() {
            const container = document.getElementById('heuresDispo');
            container.innerHTML = '';
            
            HEURES.forEach(heure => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'heure-btn';
                btn.textContent = heure;
                btn.onclick = () => selectHeure(btn, heure);
                container.appendChild(btn);
            });
        }

        function selectHeure(btn, heure) {
            document.querySelectorAll('.heure-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            heureSelectionnee = heure;
            updateWhatsApp();
        }

        function updateWhatsApp() {
            if(jourSelectionne && heureSelectionnee) {
                const nom = document.getElementById('nom').value || 'Non renseigné';
                const tel = document.getElementById('tel').value || 'Non renseigné';
                const service = document.getElementById('service');
                const serviceText = service.value || 'Non renseigné';
                const notes = document.getElementById('notes').value || 'Aucun';
                
                const recap = `📅 Jour : ${jourSelectionne.nom} ${jourSelectionne.num}
⏰ Heure : ${heureSelectionnee}
👤 Nom : ${nom}
📱 Tél : ${tel}
💅 Service : ${serviceText}
📝 Détails : ${notes}`;
                
                document.getElementById('recapText').textContent = recap;
                
                const msg = `✨ Bonjour ! Je voudrais prendre rendez-vous chez Nails by Feriel ✨

📅 Jour : ${jourSelectionne.nom} ${jourSelectionne.num}
⏰ Heure : ${heureSelectionnee}
👤 Nom : ${nom}
📱 Tél : ${tel}
💅 Service : ${serviceText}
📝 Détails : ${notes}

Merci ! ❤️`;
                
                const whatsappUrl = `https://wa.me/21699475854?text=${encodeURIComponent(msg)}`;
                document.getElementById('whatsappBtn').href = whatsappUrl;
                
                document.getElementById('whatsappSection').classList.add('active');
            }
        }

        // Mettre à jour WhatsApp quand on change les infos
        document.getElement
