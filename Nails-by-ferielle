            .form-row { grid-template-columns: 1fr; }
            .heures-dispo { grid-template-columns: repeat(3, 1fr); }
            .services-grid { grid-template-columns: 1fr; }
        }

        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s;
        }

        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>
